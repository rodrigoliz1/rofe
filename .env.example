# Frontend only. All secrets belong in backend/.env and must never use a VITE_ prefix.
# Local development: point at the Express server. On Vercel leave it empty — the API is served
# from the same domain (/api), so the PWA uses window.location.origin.
VITE_API_URL=http://localhost:3000

# Optional reconciliation. Enable only after migration 011 and secure scheduler setup.
POINT_RECONCILIATION_ENABLED=false
CRON_SECRET=

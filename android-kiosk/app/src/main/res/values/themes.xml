<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Native splash (androidx core-splashscreen): ROFÉ mark on the brand background. -->
    <style name="Theme.Rofe.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/rofe_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Rofe</item>
    </style>

    <style name="Theme.Rofe" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/rofe_background</item>
        <item name="colorPrimary">@color/rofe_gold</item>
        <item name="colorAccent">@color/rofe_gold</item>
        <item name="android:textColorPrimary">@color/rofe_ink</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.Rofe.Dialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/rofe_gold</item>
        <item name="android:background">@color/rofe_surface</item>
        <item name="android:textColorPrimary">@color/rofe_ink</item>
        <item name="android:textColor">@color/rofe_ink</item>
    </style>

    <style name="Widget.Rofe.PrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">32dp</item>
        <item name="android:paddingEnd">32dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/rofe_background</item>
        <item name="backgroundTint">@color/rofe_ink</item>
    </style>
</resources>

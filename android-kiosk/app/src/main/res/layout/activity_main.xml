<?xml version="1.0" encoding="utf-8"?>
<!-- The WebView is added to web_container at runtime. status_overlay covers it while
     loading or when ROFE cannot be reached, so customers never see a white page. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rofe_background">

    <FrameLayout
        android:id="@+id/web_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/status_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/rofe_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:id="@+id/overlay_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/brand_description"
            android:fontFamily="sans-serif-black"
            android:hapticFeedbackEnabled="false"
            android:letterSpacing="-0.04"
            android:textColor="@color/rofe_ink"
            android:textSize="72sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.4"
            android:text="@string/brand_kicker"
            android:textColor="@color/rofe_muted"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/overlay_progress"
            style="?android:attr/progressBarStyle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="40dp"
            android:indeterminateTint="@color/rofe_gold" />

        <TextView
            android:id="@+id/overlay_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/status_connecting_title"
            android:textColor="@color/rofe_ink"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/overlay_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxWidth="480dp"
            android:textColor="@color/rofe_muted"
            android:textSize="16sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/overlay_retry"
            style="@style/Widget.Rofe.PrimaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/status_retry"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>

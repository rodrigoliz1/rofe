<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow http:// for a LAN dev server (e.g. http://192.168.x.x:5173/kiosk).
     Certificates are still validated against system CAs for HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

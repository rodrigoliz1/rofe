NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=ALLOWED_ORIGINS=http://localhost:5173,http://192.168.0.8:5173
TRUST_PROXY=1
LOG_LEVEL=info
API_RATE_LIMIT_MAX=180

# Generate independent 32+ byte values: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Generate hashes with: node scripts/hash-password.cjs "your-password"
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@rofe.local
AUTH_BOOTSTRAP_ADMIN_HASH=
AUTH_BOOTSTRAP_BARISTA_EMAIL=barista@rofe.local
AUTH_BOOTSTRAP_BARISTA_HASH=

# Used once when authorizing a new iPad. Use 16+ random characters.
DEVICE_ENROLLMENT_SECRET=

# Supabase production database (service role key stays backend-only).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Mercado Pago Point Orders API.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
POINT_DEVICE_ID=
ENABLE_PAYMENT_SIMULATION=false

# Public QR pickup. Stripe Checkout keeps card details off ROFE servers.
# Use test keys while developing; never expose these with a VITE_ prefix.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Frontend origin only, without /pedir; HTTPS is required in production.
PUBLIC_ORDERING_URL=
# Optional emergency shutdown; normal open/pause control is in Admin > Pedidos QR.
PICKUP_ENABLED=true
PICKUP_LOCATION_NAME=ROFÉ Espresso Bar
PICKUP_LOCATION_ADDRESS=

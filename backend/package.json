{
  "name": "cafe-backend",
  "version": "1.0.0",
  "description": "POS Backend for Cafe Motocarro",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:db": "bash scripts/test-migrations.sh",
    "check:production": "tsx scripts/check-production.ts",
    "check:pickup": "tsx scripts/check-pickup.ts",
    "point:mode": "tsx scripts/point-mode.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "stripe": "^23.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^5.4.5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
